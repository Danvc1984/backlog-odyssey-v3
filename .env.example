# Copy to .env and fill in real values. Never commit .env* to Git.

# --- Database (Supabase PostgreSQL) ---
# DIRECT_URL targets the direct connection, used for migrations and seeds.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/backlog_odyssey
# DATABASE_URL targets the pooled/transaction URL, used at runtime by the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backlog_odyssey

# --- Auth.js (Google) ---
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3500
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Access control ---
# The only Google email allowed to use the application.
ALLOWED_GOOGLE_EMAIL=