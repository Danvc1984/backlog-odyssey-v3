// Backlog Odyssey — Prisma schema (MVP)
// Modeled on the product-level data model in the PRD. This version uses Prisma 7
// (prisma-client generator + prisma.config.ts). Output is generated to
// ../src/generated/prisma.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum GameType {
  BASE_GAME
  DLC
}

enum Origin {
  STEAM_IMPORT
  MANUAL
}

enum MatchMethod {
  EXACT_STEAM_APP_ID
  MANUAL_RAWG_SEARCH
  MANUAL_ITAD_LOOKUP
  INFERRED
}

enum AvailabilitySource {
  STEAM
  OTHER_PLATFORM
  ROM
}

enum PlayState {
  NOT_STARTED
  IN_PROGRESS
  PLAYED_BEFORE
  ABANDONED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum Environment {
  BAZZITE
  STEAM_DECK
  WINDOWS
}

enum GameExperience {
  PC_GAMING
  MULTIPLAYER_COOP
  COUCH_GAMING
  ON_THE_GO
}

enum CompatibilityStatus {
  READY
  READY_WITH_TINKERING
  FALLBACK_RECOMMENDED
  REQUIRED
  UNKNOWN
}

enum DuplicateStatus {
  OPEN
  DISMISSED
}

enum CatalogOperationType {
  MERGE
  DELETE
}

enum CatalogOperationState {
  PENDING
  UNDONE
  EXPIRED
  COMPLETED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum RecommendationKind {
  PLAY_NEXT
  BUY
}

enum RecommendationRole {
  BEST_FIT_1
  BEST_FIT_2
  OUT_OF_THE_BOX
  CHANGE_OF_PACE
  DEAL
}

enum RecommendationEventKind {
  EXPOSURE
  ROTATION
  TASTE_SETUP_ANSWER
  START
  COMPLETION
  ABANDONMENT
  DISMISSAL
}

enum RecommendationDimension {
  GENRE
  TAG
  EXPERIENCE
  DURATION
  PUBLISHER
  ERA
  SERIES
  ENVIRONMENT
  MATURITY
}

enum RecommendationPreferenceAttitude {
  PREFER
  NEUTRAL
  AVOID
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum EnrichmentJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  AWAITING_MATCH
  SUCCEEDED
  FAILED
}

enum EnrichmentJobStage {
  MATCHING
  PERSISTING
  RETRYING
  COMPLETE
  FAILED
}

enum UnresolvedDlcStatus {
  PENDING
  DISCARDED
}

enum UnresolvedDlcSource {
  OWNED_SYNC
  WISHLIST_IMPORT
}

enum WishlistImportReviewStatus {
  OPEN
  LINKED
  IGNORED
}

enum Provider {
  PROTONDB
  ARE_WE_ANTICHEAT_YET
  STEAM_DECK_VERIFIED
  RAWG
  ITAD
  STEAM
  WALLHAVEN
}

enum PriceIdentityProvenance {
  STEAM_IMPORT
  USER
  RAWG_SUGGESTION
}

// ---------------------------------------------------------------------------
// Authentication (Auth.js with Google, database sessions)
// ---------------------------------------------------------------------------

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  operations    CatalogOperation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Settings and connections (singletons)
// ---------------------------------------------------------------------------

model AppSettings {
  id                    Int      @id @default(1)
  theme                 Theme    @default(SYSTEM)
  desktopOs             String   @default("BAZZITE")
  portableDevice        String   @default("STEAM_DECK")
  fallbackOs            String   @default("WINDOWS")
  priceCountry          String   @default("MX")
  timeZone              String   @default("America/Mexico_City") // IANA; Mexico eliminated DST in 2023, permanently UTC-6
  wallpaperEnabled      Boolean  @default(true)
  reducedData           Boolean  @default(false)
  steamDailySyncEnabled Boolean  @default(true)
  itadDailyRefresh      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SteamConnection {
  id         Int       @id @default(1)
  steamId64  String    @unique
  state      String
  lastSyncAt DateTime?
  counts     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SteamRecentActivityCache {
  id             Int       @id @default(1)
  entries        Json?
  refreshedAt    DateTime?
  lastAttemptAt  DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Game {
  id         String   @id @default(cuid())
  type       GameType @default(BASE_GAME)
  origin     Origin
  name       String
  baseGameId String?
  importAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  baseGame            Game?                      @relation("DLCToBase", fields: [baseGameId], references: [id], onDelete: Cascade)
  dlcs                Game[]                     @relation("DLCToBase")
  externalIds         ExternalGameId[]
  metadataSnapshots   MetadataSnapshot[]
  enrichmentJobs      EnrichmentJob[]
  libraryEntry        LibraryEntry?
  availability        GameAvailability[]
  wishlistDlcs        WishlistEntry[]            @relation("WishlistDlcToBase")
  collections         CollectionMembership[]
  tags                GameTag[]
  compatSnapshots     CompatibilitySnapshot[]
  envCompat           EnvironmentCompatibility[]
  duplicatesA         PossibleDuplicate[]        @relation("DuplicatePairA")
  duplicatesB         PossibleDuplicate[]        @relation("DuplicatePairB")
  recommendationItems RecommendationItem[]
  recommendationEvents RecommendationEvent[]

  @@index([baseGameId])
  @@index([origin])
  @@index([type])
}

model UnresolvedSteamDlc {
  id             String              @id @default(cuid())
  steamAppId     String              @unique
  name           String
  steamBaseAppId String?
  source         UnresolvedDlcSource @default(OWNED_SYNC)
  status         UnresolvedDlcStatus @default(PENDING)
  discardedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
}

model WishlistImportReview {
  id         String                     @id @default(cuid())
  steamAppId String                     @unique
  name       String
  candidates Json
  status     WishlistImportReviewStatus @default(OPEN)
  reviewedAt DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([status])
}

model WishlistImportIgnore {
  id         String   @id @default(cuid())
  steamAppId String   @unique
  name       String
  createdAt  DateTime @default(now())
}

model ExternalGameId {
  id          String      @id @default(cuid())
  namespaceId String      @db.Text
  namespace   String
  externalId  String
  matchMethod MatchMethod @default(EXACT_STEAM_APP_ID)
  gameId      String

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([namespace, externalId])
  @@index([gameId])
}

// ---------------------------------------------------------------------------
// Metadata and organization
// ---------------------------------------------------------------------------

model MetadataSnapshot {
  id        String    @id @default(cuid())
  gameId    String
  provider  Provider
  payload   Json
  sourceUrl String?
  fetchedAt DateTime  @default(now())
  expiresAt DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, provider])
}

model EnrichmentJob {
  id               String              @id @default(cuid())
  gameId           String
  syncRunId        String?
  provider         Provider
  status           EnrichmentJobStatus @default(QUEUED)
  stage            EnrichmentJobStage  @default(MATCHING)
  attempt          Int                 @default(0)
  maxAttempts      Int                 @default(3)
  progress         Int                 @default(0)
  nextAttemptAt    DateTime?
  candidatePayload Json?
  selectedRawgId   Int?
  lastErrorCode    String?
  lastErrorMessage String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  syncRun SyncRun? @relation(fields: [syncRunId], references: [id], onDelete: SetNull)

  @@unique([gameId, provider])
  @@index([status, nextAttemptAt])
  @@index([syncRunId])
}

model PersonalTag {
  id    String    @id @default(cuid())
  name  String    @unique
  games GameTag[]
}

model GameTag {
  gameId String
  tagId  String

  game Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  tag  PersonalTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([gameId, tagId])
}

model Collection {
  id        String                 @id @default(cuid())
  name      String                 @unique
  color     String?
  icon      String?
  isSystem  Boolean                @default(false)
  members   CollectionMembership[]
  createdAt DateTime               @default(now())
}

model CollectionMembership {
  collectionId String
  gameId       String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  game       Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([collectionId, gameId])
}

// ---------------------------------------------------------------------------
// Library, availability, wishlist, prices
// ---------------------------------------------------------------------------

model LibraryEntry {
  id                   String               @id @default(cuid())
  gameId               String               @unique
  playState            PlayState            @default(NOT_STARTED)
  isMainGame           Boolean              @default(false)
  priority             Priority?            @default(NONE)
  interest             Int?
  rating               Int?
  preferredEnvironment Environment?
  gameExperience       GameExperience?
  compatOverrideStatus CompatibilityStatus?
  compatOverrideReason String?
  playSoon             Boolean              @default(false)
  replayCandidate      Boolean              @default(false)
  hidden               Boolean              @default(false)
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([playState])
  @@index([isMainGame])
}

model AlternativeSource {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  knownKey       String?   @unique
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  availability GameAvailability[]
}

model GameAvailability {
  id                   String             @id @default(cuid())
  gameId               String
  source               AvailabilitySource
  alternativeSourceId  String?
  displayName          String?
  steamAppId           String?
  steamPlaytimeTotal   BigInt?
  steamLastPlayed      DateTime?
  addedAt              DateTime           @default(now())

  game              Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  alternativeSource AlternativeSource? @relation(fields: [alternativeSourceId], references: [id], onDelete: Restrict)

  @@unique([gameId, source, alternativeSourceId])
  @@index([gameId])
}

model WishlistEntry {
  id                   String   @id @default(cuid())
  name                 String
  type                 GameType @default(BASE_GAME)
  baseGameId           String?
  interest             Int?
  gameExperience       GameExperience?
  targetPriceMxn       Decimal? @db.Decimal(10, 2)
  notes                String?
  steamAppId           String?
  steamAppIdProvenance PriceIdentityProvenance?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  baseGame         Game?                     @relation("WishlistDlcToBase", fields: [baseGameId], references: [id], onDelete: Cascade)
  metadataSnapshot WishlistMetadataSnapshot?
  offers           DealOffer[]
  refreshes        PriceRefresh[]
  compatSnapshots  WishlistCompatibilitySnapshot[]
  envCompat        WishlistEnvironmentCompatibility[]
  recommendationItems RecommendationItem[]
  recommendationEvents RecommendationEvent[]

  @@index([baseGameId])
  @@index([type])
}

model WishlistMetadataSnapshot {
  id              String    @id @default(cuid())
  wishlistEntryId String    @unique
  provider        Provider  @default(RAWG)
  payload         Json
  sourceUrl       String?
  fetchedAt       DateTime  @default(now())
  expiresAt       DateTime?

  wishlistEntry WishlistEntry @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)

  @@index([wishlistEntryId, provider])
}

model DealOffer {
  id              String    @id @default(cuid())
  wishlistEntryId String
  shop            String
  country         String?
  currency        String?
  price           Decimal?  @db.Decimal(10, 2)
  regularPrice    Decimal?  @db.Decimal(10, 2)
  discount        Int?
  historicalLow   Decimal?  @db.Decimal(10, 2)
  sourceCurrency  String?
  sourcePrice     Decimal?  @db.Decimal(10, 2)
  sourceRegularPrice Decimal? @db.Decimal(10, 2)
  sourceHistoricalLow Decimal? @db.Decimal(10, 2)
  exchangeRateToMxn Decimal? @db.Decimal(14, 6)
  exchangeRateFetchedAt DateTime?
  voucher         String?
  itadFlag        String?
  drm             String?
  platforms       Json?
  url             String?
  expiresAt       DateTime?
  fetchedAt       DateTime  @default(now())

  wishlistEntry WishlistEntry @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)

  @@index([wishlistEntryId])
}

model ItadIdentity {
  steamAppId String   @id
  itadId     String
  fetchedAt  DateTime @default(now())
}

model PriceRefresh {
  id              String     @id @default(cuid())
  wishlistEntryId String?
  status          SyncStatus
  country         String?
  requestedAt     DateTime   @default(now())
  finishedAt      DateTime?
  counts          Json?

  wishlistEntry WishlistEntry? @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
}

model WishlistCompatSweep {
  id          String     @id @default(cuid())
  status      SyncStatus
  counts      Json?
  requestedAt DateTime   @default(now())
  finishedAt  DateTime?

  @@index([status, requestedAt])
}

// ---------------------------------------------------------------------------
// Compatibility
// ---------------------------------------------------------------------------

model CompatibilitySnapshot {
  id        String    @id @default(cuid())
  gameId    String
  provider  Provider
  result    Json?
  sourceUrl String?
  fetchedAt DateTime  @default(now())
  expiresAt DateTime?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, provider])
}

model EnvironmentCompatibility {
  id          String              @id @default(cuid())
  gameId      String
  environment Environment
  status      CompatibilityStatus
  source      String?
  updatedAt   DateTime            @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, environment])
}

model WishlistCompatibilitySnapshot {
  id              String    @id @default(cuid())
  wishlistEntryId String
  provider        Provider
  result          Json?
  sourceUrl       String?
  fetchedAt       DateTime  @default(now())
  expiresAt       DateTime?

  wishlistEntry WishlistEntry @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)

  @@unique([wishlistEntryId, provider])
}

model WishlistEnvironmentCompatibility {
  id              String              @id @default(cuid())
  wishlistEntryId String
  environment     Environment
  status          CompatibilityStatus
  source          String?
  updatedAt       DateTime            @updatedAt

  wishlistEntry WishlistEntry @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)

  @@unique([wishlistEntryId, environment])
}

// ---------------------------------------------------------------------------
// Duplicates
// ---------------------------------------------------------------------------

model PossibleDuplicate {
  id         String          @id @default(cuid())
  gameAId    String
  gameBId    String
  evidence   Json?
  confidence Float?
  status     DuplicateStatus @default(OPEN)
  reviewedAt DateTime?

  gameA Game @relation("DuplicatePairA", fields: [gameAId], references: [id], onDelete: Cascade)
  gameB Game @relation("DuplicatePairB", fields: [gameBId], references: [id], onDelete: Cascade)

  @@unique([gameAId, gameBId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Recommendations
// ---------------------------------------------------------------------------

model RecommendationRun {
  id        String               @id @default(cuid())
  kind      RecommendationKind
  context   Json?
  createdAt DateTime             @default(now())
  items     RecommendationItem[]
  events    RecommendationEvent[]

  @@index([kind, createdAt])
}

model RecommendationItem {
  id              String   @id @default(cuid())
  runId           String
  gameId          String?
  wishlistEntryId String?
  rank            Int
  score           Float
  positive        Json?
  negative        Json?
  caveats         Json?
  role            RecommendationRole?
  createdAt       DateTime @default(now())

  run           RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  game          Game?             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  wishlistEntry WishlistEntry?    @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model RecommendationFeedback {
  id              String             @id @default(cuid())
  gameId          String?
  wishlistEntryId String?
  kind            RecommendationKind
  createdAt       DateTime           @default(now())

  @@index([gameId, kind])
  @@index([wishlistEntryId, kind])
}

model RecommendationEvent {
  id              String                  @id @default(cuid())
  kind            RecommendationEventKind
  gameId          String?
  wishlistEntryId String?
  runId           String?
  reason          String?
  payload         Json?
  createdAt       DateTime                @default(now())

  game          Game?             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  wishlistEntry WishlistEntry?    @relation(fields: [wishlistEntryId], references: [id], onDelete: Cascade)
  run           RecommendationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([kind, createdAt])
  @@index([gameId, kind])
  @@index([wishlistEntryId, kind])
  @@index([runId])
}

model RecommendationProfile {
  id        Int      @id @default(1)
  version   Int      @default(1)
  payload   Json
  rebuiltAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecommendationPreference {
  id        String                            @id @default(cuid())
  dimension RecommendationDimension
  value     String
  attitude  RecommendationPreferenceAttitude
  createdAt DateTime                          @default(now())
  updatedAt DateTime                          @updatedAt

  @@unique([dimension, value])
}

model RecommendationTuneState {
  id        Int      @id @default(1)
  playTune  Json?
  buyTune   Json?
  updatedAt DateTime @updatedAt
}

model RecommendationPreset {
  id        String   @id @default(cuid())
  name      String   @unique
  tune      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Theme and operations
// ---------------------------------------------------------------------------

model WallpaperState {
  id           Int      @id @default(1)
  candidates   Json?
  selectedIdx  Int      @default(0)
  renderTarget Json?
  cachedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SyncRun {
  id             String          @id @default(cuid())
  provider       Provider
  status         SyncStatus
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  counts         Json?
  diagnostics    Json?
  enrichmentJobs EnrichmentJob[]

  @@index([provider, status])
}

model CatalogOperation {
  id              String                @id @default(cuid())
  userId          String
  type            CatalogOperationType
  state           CatalogOperationState @default(PENDING)
  affectedGameIds String[]
  snapshot        Json?
  expiresAt       DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([expiresAt])
}
